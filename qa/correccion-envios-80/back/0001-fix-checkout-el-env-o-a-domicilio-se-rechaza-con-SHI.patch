-            unit_amount: Math.round(line.unitPrice * 100),
-            product_data: {
-              name: line.variantLabel ? `${line.name} · ${line.variantLabel}` : line.name,
+        line_items: [
+          ...prepared.lines.map((line) => ({
+            quantity: line.quantity,
+            price_data: {
+              currency: CURRENCY,
+              unit_amount: Math.round(line.unitPrice * 100),
+              product_data: {
+                name: line.variantLabel ? `${line.name} · ${line.variantLabel}` : line.name,
+              },
             },
-          },
-        })),
+          })),
+          // El envío va como una línea más para que Stripe cobre el mismo total de la orden.
+          ...(shippingCents > 0 ? [{ quantity: 1, price_data: { currency: CURRENCY, unit_amount: shippingCents, product_data: { name: "Envío a domicilio" } } }] : []),
+        ],
         client_reference_id: orderId,
         metadata: { orderId },
         integration_identifier: `northbike_checkout_${randomLetters(8)}`,
@@ -204,6 +210,7 @@ export class CheckoutService {
     publicToken: string,
     reservationExpiresAt: Date,
     dto: CreateCheckoutSessionDto,
+    shippingCents: number,
   ) {
     return this.prisma.$transaction(async (tx) => {
       const uniqueKeys = new Set<string>();
@@ -344,8 +351,8 @@ export class CheckoutService {
           paymentStatus: "pending",
           currency: CURRENCY,
           subtotal,
-          shippingTotal: 0,
-          total: subtotal,
+          shippingTotal: shippingCents / 100,
+          total: roundMoney(subtotal + shippingCents / 100),
           customerName: dto.customer.name.trim(),
           customerEmail: dto.customer.email.trim().toLowerCase(),
           customerPhone: dto.customer.phone.trim(),
