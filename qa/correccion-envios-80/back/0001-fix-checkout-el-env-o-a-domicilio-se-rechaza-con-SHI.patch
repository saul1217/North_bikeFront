 });
 
 test("productos del POS: bloqueados con llave LIVE salvo ECOMMERCE_POS_LIVE_ENABLED=true", () => {
@@ -45,13 +41,27 @@ function service(env: Record<string, string>) {
 const customer = { name: "Cliente", email: "c@example.com", phone: "5512345678" };
