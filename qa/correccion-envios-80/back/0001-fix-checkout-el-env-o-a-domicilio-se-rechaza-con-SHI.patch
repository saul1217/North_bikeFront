     const afterShip = { ...(await counts()), sesiones: fake.sessions.size, ordenes: await prisma.ecommerceOrder.count(), stock: (await prisma.onlineProduct.findUniqueOrThrow({ where: { id: casquillo.id } })).stock };
     numbers.envioBloqueado = { status: [ship.status, shipPos.status], mensaje: ship.body?.message, antes: beforeShip, despues: afterShip };
-    check("ENVÍO BLOQUEADO por defecto: shipping con dirección da 400 «solo recoger en tienda» (manual y POS)", ship.status === 400 && shipPos.status === 400 && /recoger en tienda/.test(String(ship.body?.message)), numbers.envioBloqueado);
+    check("ENVÍO SIN TARIFA (#80): shipping con dirección da 400 SHIPPING_RATE_PENDING «por confirmar» (manual y POS)", ship.status === 400 && shipPos.status === 400 && ship.body?.error === "SHIPPING_RATE_PENDING" && /por confirmar/.test(String(ship.body?.message)), numbers.envioBloqueado);
     check("el 400 de envío no crea orden, sesión de Stripe, ventas ni movimientos, ni aparta stock", JSON.stringify(beforeShip) === JSON.stringify(afterShip), numbers.envioBloqueado);
     const shipNoAddr = await checkout([{ productId: casquillo.id, quantity: 1, source: "manual" }], { method: "shipping" });
     check("shipping sin dirección: 400", shipNoAddr.status === 400, shipNoAddr.status);
-    for (const flag of ["false", "1", "yes"]) {
+    // La variable vieja ya no existe: ningún valor enciende un envío en $0.
+    for (const flag of ["false", "1", "yes", "true"]) {
       process.env.ECOMMERCE_SHIPPING_ENABLED = flag;
       const r = await checkout([{ productId: casquillo.id, quantity: 1, source: "manual" }], { method: "shipping", address });
-      check(`ECOMMERCE_SHIPPING_ENABLED="${flag}" sigue bloqueando (400)`, r.status === 400, r.status);
+      check(`ECOMMERCE_SHIPPING_ENABLED="${flag}" no habilita cobrar envío sin tarifa (400)`, r.status === 400 && r.body?.error === "SHIPPING_RATE_PENDING", r.status);
     }
     delete process.env.ECOMMERCE_SHIPPING_ENABLED;
     const pickupOk = await checkout([{ productId: casquillo.id, quantity: 1, source: "manual" }], pickup);
@@ -360,12 +361,6 @@ async function main() {
     const shipCost = await api("POST", "/checkout/session", { items: [{ productId: casquillo.id, quantity: 1, source: "manual" }], customer, fulfillment: { method: "pickup" }, shippingTotal: -100 });
     const lastSession = [...fake.sessions.values()].pop();
     check("un shippingTotal manipulado en el cuerpo se ignora (whitelist)", shipCost.status === 201 && lastSession?.amount_total === 15025, { status: shipCost.status, stripe: lastSession?.amount_total });
-    // Solo para comprobar que la opción futura funciona (no es la configuración del lanzamiento).
-    process.env.ECOMMERCE_SHIPPING_ENABLED = "true";
-    const shipOn = await checkout([{ productId: casquillo.id, quantity: 1, source: "manual" }], { method: "shipping", address });
-    const oShipOn = await prisma.ecommerceOrder.findUnique({ where: { id: shipOn.body?.orderId } });
-    delete process.env.ECOMMERCE_SHIPPING_ENABLED;
-    check("con ECOMMERCE_SHIPPING_ENABLED=true se acepta (201) y sigue con shippingTotal 0: no encender sin política", shipOn.status === 201 && Number(oShipOn?.shippingTotal) === 0, { status: shipOn.status, shippingTotal: Number(oShipOn?.shippingTotal) });
 
     // ------------------------------------- R1 / R5 (documentar, no corregir)
     area = "riesgos-inventario";
diff --git a/src/checkout/checkout-rules.ts b/src/checkout/checkout-rules.ts
index 93d54b9..f259d45 100644
--- a/src/checkout/checkout-rules.ts
+++ b/src/checkout/checkout-rules.ts
@@ -56,14 +56,22 @@ export function isLiveStripeKey(key: string | undefined | null) {
 }
 
 /**
- * Envío a domicilio: apagado mientras ECOMMERCE_SHIPPING_ENABLED no sea
- * exactamente "true". No hay costos, zonas ni política de envío definidos; con
- * esto solo se puede recoger en tienda, aunque la petición llegue directo a la API.
+ * Costo de envío en centavos MXN que se cobra en un pedido.
+ *
+ * North Bike sí envía a domicilio, pero todavía no hay una tarifa autorizada
+ * (fija, por zona o cotizada): para "shipping" devuelve null y el checkout se
+ * rechaza antes de apartar inventario o abrir Stripe. Nunca se cobra un envío
+ * en $0 por omisión. Recoger en tienda no lleva cargo de envío.
+ * Cuando el negocio defina la regla, se calcula aquí (solo en el servidor).
  */
-export function shippingEnabled(flag: string | undefined | null) {
-  return flag?.trim().toLowerCase() === "true";
+export function shippingCentsFor(method: "pickup" | "shipping"): number | null {
+  if (method === "pickup") return 0;
+  return null;
 }
 
+export const SHIPPING_RATE_PENDING_MESSAGE =
+  "El costo de envío a domicilio está por confirmar; por ahora este pedido no se puede pagar en línea. Puedes elegir recoger en tienda.";
+
 /**
  * Productos del POS (source "pos") en LIVE: no se venden con cobros reales
  * mientras ECOMMERCE_POS_LIVE_ENABLED no sea "true" (riesgos R1, R2 y R5 del
diff --git a/src/checkout/checkout.service.ts b/src/checkout/checkout.service.ts
index 4da94b0..26f2dda 100644
--- a/src/checkout/checkout.service.ts
+++ b/src/checkout/checkout.service.ts
@@ -20,7 +20,8 @@ import {
   isReleasable,
   posItemsAllowed,
   posSaleTotals,
-  shippingEnabled,
+  shippingCentsFor,
+  SHIPPING_RATE_PENDING_MESSAGE,
   type InventorySource,
 } from "./checkout-rules";
 
@@ -65,17 +66,18 @@ export class CheckoutService {
   ) {}
 
   async createSession(dto: CreateCheckoutSessionDto) {
-    // Primera etapa: solo recoger en tienda. Se valida aquí (y no solo en la
-    // web) para que una petición directa no contrate un envío sin costo.
-    if (dto.fulfillment.method === "shipping" && !shippingEnabled(this.config.get<string>("ECOMMERCE_SHIPPING_ENABLED"))) {
-      throw new BadRequestException("Por ahora solo está disponible recoger en tienda");
-    }
     if (dto.fulfillment.method === "shipping" && !dto.fulfillment.address) {
       throw new BadRequestException("La dirección es obligatoria para envío");
     }
     if (dto.fulfillment.method === "pickup" && dto.fulfillment.address) {
       throw new BadRequestException("No se debe enviar dirección al recoger en tienda");
     }
+    // El envío lo calcula el servidor (nunca el cliente). Sin una tarifa
+    // autorizada no se aparta inventario, no se crea orden ni sesión de Stripe.
+    const shippingCents = shippingCentsFor(dto.fulfillment.method);
+    if (shippingCents === null) {
+      throw new BadRequestException({ statusCode: 400, error: "SHIPPING_RATE_PENDING", message: SHIPPING_RATE_PENDING_MESSAGE });
+    }
 
     await this.releaseExpiredReservations();
     const publicToken = randomBytes(32).toString("base64url");
@@ -83,7 +85,7 @@ export class CheckoutService {
     const reservationMinutes = this.config.get<number>("CHECKOUT_RESERVATION_TTL_MINUTES") ?? DEFAULT_RESERVATION_MINUTES;
     const reservationExpiresAt = new Date(now.getTime() + Math.max(35, reservationMinutes) * 60_000);
     const orderId = `web_${randomUUID()}`;
-    const prepared = await this.reserveAndCreateOrder(orderId, publicToken, reservationExpiresAt, dto);
+    const prepared = await this.reserveAndCreateOrder(orderId, publicToken, reservationExpiresAt, dto, shippingCents);
 
     let session: Stripe.Checkout.Session;
     try {
@@ -93,16 +95,20 @@ export class CheckoutService {
         payment_method_types: PAYMENT_METHOD_TYPES,
         customer_email: dto.customer.email.trim().toLowerCase(),
         billing_address_collection: "auto",
