-test("checkout con envío: 400 si no está habilitado, antes de tocar inventario o Stripe", async () => {
+test("checkout con envío sin tarifa: 400 SHIPPING_RATE_PENDING antes de tocar inventario, orden o Stripe", async () => {
+  const { CheckoutService } = await import("../src/checkout/checkout.service");
+  // La variable vieja ya no enciende un envío en $0.
+  for (const vars of [{ STRIPE_SECRET_KEY: "sk_test_x" }, { STRIPE_SECRET_KEY: "sk_test_x", ECOMMERCE_SHIPPING_ENABLED: "true" }]) {
+    const s = service(vars);
