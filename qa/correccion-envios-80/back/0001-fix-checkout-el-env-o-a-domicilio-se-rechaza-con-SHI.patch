+import { isLiveStripeKey, posItemsAllowed, shippingCentsFor } from "../src/checkout/checkout-rules";
 
-test("envío: solo se enciende con ECOMMERCE_SHIPPING_ENABLED exactamente true", () => {
-  assert.equal(shippingEnabled(undefined), false);
-  assert.equal(shippingEnabled(""), false);
-  assert.equal(shippingEnabled("false"), false);
-  assert.equal(shippingEnabled("1"), false);
-  assert.equal(shippingEnabled("yes"), false);
