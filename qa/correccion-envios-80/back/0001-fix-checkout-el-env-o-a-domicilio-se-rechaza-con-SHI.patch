+    await assert.rejects(
+      checkout.createSession({ items: [{ productId: "onl_1", quantity: 1, source: "manual" }], customer, fulfillment: { method: "shipping", address } } as any),
+      (error: any) => error.status === 400 && error.response?.error === "SHIPPING_RATE_PENDING" && /por confirmar/.test(error.message),
+    );
+    assert.deepEqual(s.calls, []);
+  }
+});
+
+test("checkout con envío sin dirección: 400 de dirección obligatoria", async () => {
   const { CheckoutService } = await import("../src/checkout/checkout.service");
   const s = service({ STRIPE_SECRET_KEY: "sk_test_x" });
   const checkout = new CheckoutService(s.prisma as any, s.config as any);
   await assert.rejects(
-    checkout.createSession({ items: [{ productId: "onl_1", quantity: 1, source: "manual" }], customer, fulfillment: { method: "shipping", address } } as any),
-    (error: any) => error.status === 400 && /recoger en tienda/.test(error.message),
